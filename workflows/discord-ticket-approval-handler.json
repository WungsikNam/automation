{
  "name": "Discord Ticket Master - Approval Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ticket-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "approval-webhook",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "ticket-approval-webhook"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst customId = data.data.custom_id;\nconst userId = data.member.user.id;\nconst username = data.member.user.username;\n\nconst [action, _, requestId] = customId.split('_');\n\nreturn {\n  json: {\n    action,\n    requestId,\n    userId,\n    username,\n    messageId: data.message.id,\n    channelId: data.channel_id\n  }\n};"
      },
      "id": "parse-button-click",
      "name": "Parse Button Click",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ticket_requests",
          "mode": "name"
        },
        "options": {
          "dataStartRow": 2
        }
      },
      "id": "read-tickets",
      "name": "Read All Tickets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [650, 300],
      "credentials": {
        "googleSheetsApi": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets - Ticket Master"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const requestId = $('Parse Button Click').item.json.requestId;\nconst tickets = $input.all();\n\nconst ticket = tickets.find(t => t.json.request_id === requestId);\n\nif (!ticket) {\n  throw new Error('Ticket not found: ' + requestId);\n}\n\nreturn [ticket];"
      },
      "id": "find-ticket",
      "name": "Find Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-approve",
              "leftValue": "={{ $('Parse Button Click').item.json.action }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-approval",
      "name": "Check Approval Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "issue",
        "operation": "create",
        "project": {
          "__rl": true,
          "value": "YOUR_JIRA_PROJECT_KEY",
          "mode": "name"
        },
        "issueType": {
          "__rl": true,
          "value": "={{ $json.ticket_type }}",
          "mode": "name"
        },
        "summary": "={{ $json.ticket_title }}",
        "additionalFields": {
          "description": "={{ $json.ticket_description }}",
          "assignee": {
            "__rl": true,
            "value": "={{ $json.assignee }}",
            "mode": "name"
          },
          "dueDate": "={{ $json.due_date }}"
        }
      },
      "id": "create-jira-ticket",
      "name": "Create JIRA Ticket",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [1250, 200],
      "credentials": {
        "jiraCloudApi": {
          "id": "YOUR_JIRA_CREDENTIAL_ID",
          "name": "JIRA Cloud API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const jiraKey = $('Create JIRA Ticket').item.json.key;\n\nreturn {\n  json: {\n    ...items[0].json,\n    status: 'approved',\n    jira_key: jiraKey\n  }\n};"
      },
      "id": "prepare-approved-update",
      "name": "Prepare Approved Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ticket_requests",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": ["request_id"],
          "schema": []
        },
        "options": {
          "dataStartRow": 2
        }
      },
      "id": "update-sheets-approved",
      "name": "Update Sheets - Approved",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1650, 200],
      "credentials": {
        "googleSheetsApi": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets - Ticket Master"
        }
      }
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "requestMethod": "POST",
        "url": "https://discord.com/api/v10/users/@me/channels",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"recipient_id\": $('Find Ticket').item.json.requester_id } }}",
        "options": {}
      },
      "id": "create-requester-dm-approve",
      "name": "Create Requester DM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1850, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_DISCORD_CREDENTIAL_ID",
          "name": "Discord Bot Auth"
        }
      }
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "requestMethod": "POST",
        "url": "={{ \"https://discord.com/api/v10/channels/\" + $json.id + \"/messages\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"content\": \"✅ **티켓이 승인되었습니다!**\\n\\n**Title:** \" + $('Find Ticket').item.json.ticket_title + \"\\n**JIRA Key:** \" + $('Create JIRA Ticket').item.json.key + \"\\n**Link:** https://YOUR-DOMAIN.atlassian.net/browse/\" + $('Create JIRA Ticket').item.json.key } }}",
        "options": {}
      },
      "id": "notify-requester-approved",
      "name": "Notify Requester - Approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2050, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_DISCORD_CREDENTIAL_ID",
          "name": "Discord Bot Auth"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"type\": 4, \"data\": { \"content\": \"✅ 티켓이 승인되어 JIRA에 생성되었습니다.\", \"flags\": 64 } } }}",
        "options": {}
      },
      "id": "ack-approval",
      "name": "Acknowledge Approval",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2250, 200]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    ...items[0].json,\n    status: 'rejected'\n  }\n};"
      },
